# Copy this file to .env and fill in your values. .env is never committed.

# ---- Raspberry Pi (same network as this laptop) ----
# IP address or hostname of the Pi, e.g. 192.168.1.42 or raspberrypi.local
PI_HOST=
# User you log in with over SSH
PI_USER=
# Login: a password, or an SSH key (then also uncomment the volume in docker-compose.yml)
PI_PASSWORD=
# PI_KEY_FILE=/ssh/id_ed25519

# Repo folder of the record player on the Pi (relative = inside the user's home folder)
PI_REPO_DIR=iot-smart-record-player

# ---- Optional ----
# MQTT broker on the Pi; default mqtt://PI_HOST:1883
# MQTT_URL=
# PI_SSH_PORT=22
# MAX_UPLOAD_MB=50
